---
import '../styles/global.css';
import { siteConfig } from '../lib/site-config';
import Navbar from '../components/Navbar.svelte';
import Footer from '../components/Footer.astro';
import ProgressBar from '../components/ProgressBar.svelte';
import CrosshairCursor from '../components/CrosshairCursor.svelte';
import WhatsAppButton from '../components/WhatsAppButton.svelte';
import ScrollToTop from '../components/ScrollToTop.svelte';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'COICEM S.A.S | Mantenimiento Industrial Especializado · Energía e Infraestructura',
  description = 'COICEM S.A.S — servicio de mantenimiento industrial especializado: operación, mantenimiento, construcción, energía e infraestructura para los sectores petrolero, petroquímico y energético en Colombia.',
} = Astro.props;

const siteUrl = siteConfig.domain;
const canonical = new URL(Astro.url.pathname, siteUrl).href;

// JSON-LD — solo datos reales. Sin teléfono/email/dirección (pendientes del cliente).
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: siteConfig.legalName,
  alternateName: siteConfig.shortName,
  slogan: siteConfig.tagline,
  url: siteUrl,
  description,
  areaServed: { '@type': 'Country', name: 'Colombia' },
  makesOffer: siteConfig.areas.map((a) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: a.name },
  })),
};
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: siteConfig.legalName,
  inLanguage: 'es-CO',
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0B0E14" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content={siteConfig.legalName} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon = isotipo (emblema solo, no el logo completo) -->
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- OG image 1200×630 (logo centrado sobre blanco) -->
    <meta property="og:image" content={`${siteUrl}/og-image.jpg`} />
    <meta property="og:image:alt" content="COICEM S.A.S — Mantenimiento Industrial Especializado" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={`${siteUrl}/images/coicem-logo.png`} />

    <!-- Google Fonts: preconnect + stylesheet directo en <head> (evita waterfall del @import en CSS) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@700;800;900&family=Archivo:wght@400;500;600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Ir al contenido principal</a>

    <ProgressBar client:load />
    <Navbar client:load />

    <div class="content-shell">
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>

    <WhatsAppButton client:idle />
    <ScrollToTop client:idle />
    <CrosshairCursor client:idle />

    <!-- ── Panel YaDev oculto (entregables internos · no indexado) ── -->
    <div id="yadev" class="yadev">
      <button class="yadev__tab" type="button" aria-expanded="false" aria-controls="yadev-menu" aria-label="Panel YaDev — entregables">YA<br>DEV</button>
      <div id="yadev-menu" class="yadev__menu" hidden>
        <p class="yadev__h">ENTREGABLES · YADEV</p>
        <a href="/internal/brandbook.html" target="_blank" rel="noopener">Brandbook</a>
        <a href="/internal/firma-correo.html" target="_blank" rel="noopener">Firma de correo</a>
        <a href="/internal/firma-generador.html" target="_blank" rel="noopener">Generador de firmas</a>
        <a href="/internal/hoja-membretada.html" target="_blank" rel="noopener">Hoja membretada</a>
        <a href="/internal/hoja-membretada-generador.html" target="_blank" rel="noopener">Generador de membrete</a>
        <a href="/internal/tarjeta-presentacion.html" target="_blank" rel="noopener">Tarjeta de presentación</a>
      </div>
    </div>
    <style>
      .yadev { position: fixed; left: 0; top: 50%; transform: translateY(-50%); z-index: 90; display: flex; align-items: center; }
      .yadev__tab {
        width: 30px; min-height: 74px; background: #313F50; color: #EDEDE8; border: 0; cursor: pointer;
        font-family: 'IBM Plex Mono', monospace; font-size: 0.62rem; letter-spacing: 0.08em; line-height: 1.3;
        opacity: 0.35; transition: opacity 0.18s linear; writing-mode: initial;
      }
      .yadev:hover .yadev__tab, .yadev__tab:focus-visible { opacity: 1; }
      .yadev__menu { background: #0B0E14; border: 1px solid #313F50; border-left: 0; padding: 0.85rem 1rem; min-width: 180px; }
      .yadev__h { font-family: 'IBM Plex Mono', monospace; font-size: 0.6rem; letter-spacing: 0.14em; color: #F79204; margin: 0 0 0.6rem; }
      .yadev__menu a { display: block; color: #EDEDE8; text-decoration: none; font-family: 'IBM Plex Sans', sans-serif; font-size: 0.84rem; padding: 0.45rem 0; border-top: 1px solid #161B24; }
      .yadev__menu a:hover { color: #F79204; }
      @media print { .yadev { display: none; } }
    </style>
    <script>
      (() => {
        const tab = document.querySelector('.yadev__tab');
        const menu = document.getElementById('yadev-menu');
        if (!tab || !menu) return;
        tab.addEventListener('click', () => {
          const open = menu.hasAttribute('hidden');
          if (open) { menu.removeAttribute('hidden'); tab.setAttribute('aria-expanded', 'true'); }
          else { menu.setAttribute('hidden', ''); tab.setAttribute('aria-expanded', 'false'); }
        });
      })();
    </script>

    <style>
      /* Offset por el navbar horizontal fijo (72px de alto, full-width). */
      .content-shell { padding-top: 72px; }
    </style>
  </body>
</html>
