---
/**
 * MisionVision — texto oficial del cliente (site-config.mission / .vision).
 * Brutalist editorial: dos columnas con reglas duras, labels mono, sin sombras.
 */
import { siteConfig } from '../lib/site-config';
---

<section id="nosotros" class="mv" aria-labelledby="mv-title">
  <div class="mv__inner">
    <header class="mv__head">
      <p class="mv__eyebrow">// PROPÓSITO · COICEM S.A.S</p>
      <h2 id="mv-title" class="mv__title">Quiénes somos</h2>
      <p class="mv__lead">
        Disponibilidad, confiabilidad y continuidad operativa para la industria
        petrolera, petroquímica y energética de Colombia.
      </p>
    </header>

    <div class="mv__grid">
      <article class="mv__col">
        <div class="mv__tag"><span class="mv__n">M—01</span> MISIÓN</div>
        <p class="mv__text">{siteConfig.mission}</p>
      </article>
      <article class="mv__col mv__col--alt">
        <div class="mv__tag"><span class="mv__n">V—2030</span> VISIÓN</div>
        <p class="mv__text">{siteConfig.vision}</p>
      </article>
    </div>

    <!-- Compromiso HSEQ — marco "Cero" (estándar del sector O&M, ver INVESTIGACION-SECTOR.md R3) -->
    <section class="mv__zero" aria-labelledby="mv-zero-title">
      <div class="mv__zero-head">
        <p class="mv__zero-tag">// COMPROMISO HSEQ · NORSOK + ISO 9001/14001/45001</p>
        <h3 id="mv-zero-title" class="mv__zero-title">Política de los cuatro ceros</h3>
      </div>
      <ul class="mv__zero-grid" role="list">
        <li class="mv__zero-cell"><span class="mv__zero-n">00</span><span class="mv__zero-l">Cero accidentes</span></li>
        <li class="mv__zero-cell"><span class="mv__zero-n">00</span><span class="mv__zero-l">Cero incidentes ambientales</span></li>
        <li class="mv__zero-cell"><span class="mv__zero-n">00</span><span class="mv__zero-l">Cero paradas no programadas</span></li>
        <li class="mv__zero-cell"><span class="mv__zero-n">00</span><span class="mv__zero-l">Cero defectos de calidad</span></li>
      </ul>
    </section>
  </div>
</section>

<style>
  .mv {
    background: var(--c-black);
    border-top: 1px solid var(--c-metal);
    border-bottom: 1px solid var(--c-metal);
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1.25rem, 4vw, 4rem);
  }
  .mv__inner { max-width: 1320px; margin: 0 auto; }

  .mv__head { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .mv__eyebrow {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.18em;
    color: var(--c-accent); text-transform: uppercase; margin: 0 0 0.75rem;
  }
  .mv__title {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.8rem, 5vw, 3.25rem); color: var(--c-highlight);
    margin: 0; letter-spacing: -0.01em; line-height: 1.02;
  }

  .mv__grid {
    display: grid; grid-template-columns: 1fr; gap: 0;
    border: 1px solid var(--c-metal);
  }
  @media (min-width: 860px) {
    .mv__grid { grid-template-columns: 1fr 1fr; }
    .mv__col--alt { border-left: 1px solid var(--c-metal); }
  }
  .mv__col {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 0;
  }
  @media (max-width: 859px) {
    .mv__col--alt { border-top: 1px solid var(--c-metal); }
  }

  .mv__tag {
    font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.1em;
    color: var(--c-highlight); text-transform: uppercase;
    border-bottom: 1px solid var(--c-metal); padding-bottom: 0.85rem; margin-bottom: 1.25rem;
    display: flex; align-items: baseline; gap: 0.6rem;
  }
  .mv__n { color: var(--c-accent); font-size: 0.72rem; }

  .mv__text {
    font-family: var(--font-body); font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.6; color: rgba(237, 237, 232, 0.82); margin: 0;
  }

  .mv__lead {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    line-height: 1.5;
    color: var(--c-highlight);
    max-width: 60ch;
    margin: 1.5rem 0 0;
  }

  /* ── Compromiso "Cero" (marco HSEQ del sector) ── */
  .mv__zero {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--c-metal);
  }
  .mv__zero-head {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--c-metal);
  }
  .mv__zero-tag {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.16em;
    color: var(--c-accent); text-transform: uppercase; margin: 0 0 0.6rem;
  }
  .mv__zero-title {
    font-family: var(--font-display); font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.3rem, 3vw, 2rem); color: var(--c-highlight);
    margin: 0; letter-spacing: -0.01em; line-height: 1.05;
  }
  .mv__zero-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr);
  }
  .mv__zero-cell {
    display: flex; flex-direction: column; gap: 0.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-left: 1px solid var(--c-metal);
  }
  .mv__zero-cell:first-child { border-left: 0; }
  .mv__zero-n {
    font-family: var(--font-mono); font-weight: 600;
    font-size: clamp(1.6rem, 3.5vw, 2.6rem); line-height: 1; color: var(--c-accent);
  }
  .mv__zero-l {
    font-family: var(--font-mono); font-size: clamp(0.7rem, 1vw, 0.82rem);
    letter-spacing: 0.08em; text-transform: uppercase; color: rgba(237, 237, 232, 0.82);
  }
  @media (max-width: 859px) {
    .mv__zero-grid { grid-template-columns: 1fr 1fr; }
    .mv__zero-cell:nth-child(2) { border-left: 1px solid var(--c-metal); }
    .mv__zero-cell:nth-child(3) { border-left: 0; border-top: 1px solid var(--c-metal); }
    .mv__zero-cell:nth-child(4) { border-top: 1px solid var(--c-metal); }
  }
  @media (max-width: 520px) {
    .mv__zero-grid { grid-template-columns: 1fr; }
    .mv__zero-cell { border-left: 0; border-top: 1px solid var(--c-metal); }
    .mv__zero-cell:first-child { border-top: 0; }
    .mv__zero-cell:nth-child(2) { border-left: 0; }
  }
</style>
