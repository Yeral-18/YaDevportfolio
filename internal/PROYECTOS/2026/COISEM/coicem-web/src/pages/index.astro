---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import MisionVision from '../components/MisionVision.astro';
import Areas from '../components/Areas.astro';
import Contact from '../components/Contact.svelte';
---

<Layout>
  <Hero>
    <img
      slot="visual"
      src="/images/coicem-emblema.png"
      alt="Emblema COICEM S.A.S — engranaje, edificios y herramientas"
      width="838" height="821"
      loading="eager"
    />
  </Hero>
  <MisionVision />
  <Areas />
  <Contact client:visible />
</Layout>
