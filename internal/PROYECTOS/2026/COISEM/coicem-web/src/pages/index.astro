import Areas from '../components/Areas.astro';
import Contact from '../components/Contact.svelte';
import LogoExploded from '../components/LogoExploded.svelte';
---

<Layout>
  <Hero>
    <LogoExploded slot="visual" client:visible />
  </Hero>
  <MisionVision />
  <Areas />
  <Contact client:visible />
</Layout>
